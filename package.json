{
  "name": "design-work",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "node scripts/run-dev.mjs",
    "dev:app": "vite",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "tsc && vite build",
    "build:html": "npm run build && node scripts/build-single-html.mjs",
    "benchmark:assets": "tsx server/database.benchmark.ts",
    "lint": "npx eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "tsx --test server/*.test.ts server/**/*.test.ts",
    "preview": "vite preview",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "node scripts/run-start.mjs",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run typecheck:client && npm run typecheck:server"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "express": "^5.2.1",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.4",
    "tailwind-merge": "^2.2.1",
    "undici": "^7.29.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "22.15.3",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.6.0",
    "postcss": "^8.4.35",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
